OPENAI_API_KEY=your_openai_api_key_here

# Optional alternative LLM providers — set provider in admin panel to switch
VENICE_API_KEY=                  # https://venice.ai — paid, OpenAI-compatible
GROQ_API_KEY=                    # https://console.groq.com — free tier, 100K tokens/day (gsk_...)
CEREBRAS_API_KEY=                # https://cloud.cerebras.ai — free, NO daily token cap, 60 req/min (csk_...)

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
FRONTEND_URL=http://localhost:5173
AKSHITA_PASSWORD=your_password_here
PRADIP_PASSWORD=your_password_here
ADMIN_PASSWORD=your_password_here

# Optional. Leave blank until Razorpay setup is complete.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Alert emails (rate limit notifications) ──────────────────────────────────
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your-gmail@gmail.com
ALERT_SMTP_PASSWORD=your-gmail-app-password
ALERT_TO_EMAIL=likhapohai@gmail.com
