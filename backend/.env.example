OPENAI_API_KEY=your_openai_api_key_here

# Optional alternative LLM providers — set provider in admin panel to switch
VENICE_API_KEY=                  # https://venice.ai — paid, OpenAI-compatible
GROQ_API_KEY=                    # https://console.groq.com — free tier, 100K tokens/day (gsk_...)
CEREBRAS_API_KEY=                # https://cloud.cerebras.ai — free, NO daily token cap, 60 req/min (csk_...)

# ── Primary Supabase project (Grade 1–10 content + all user/auth data) ───────
SUPABASE_URL=your_supabase_url_here               # https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here          # publishable / anon key  (sb_publishable_...)
SUPABASE_ANON_KEY=your_supabase_anon_jwt_here     # anon JWT  (eyJ...)

# Service role key — required for admin client (bypasses RLS).
# Use SUPABASE_SERVICE_ROLE_KEY (preferred) or SUPABASE_SERVICE_KEY (alias).
# NEVER expose this value publicly. Set only one of these.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # service_role JWT — NEVER expose publicly
# SUPABASE_SERVICE_KEY=                           # alias accepted by diagnostics

# ── Secondary Supabase project (Grade 11 & 12 RAG + question bank) ───────────
SUPABASE_GRADE_1112_URL=your_grade1112_supabase_url_here       # https://xxxx.supabase.co
SUPABASE_GRADE_1112_SERVICE_KEY=your_grade1112_service_role_key # service_role JWT — NEVER expose publicly
FRONTEND_URL=http://localhost:5173
AKSHITA_PASSWORD=your_password_here
PRADIP_PASSWORD=your_password_here
ADMIN_PASSWORD=your_password_here

# Optional. Leave blank until Razorpay setup is complete.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudflare R2 — lesson audio storage (10 GB free) ────────────────────────
# Setup: dash.cloudflare.com → R2 → Create bucket "lesson-audio" → Enable public access
# API token: R2 → Manage R2 API Tokens → Create Token (Object Read & Write, specific bucket)
R2_ACCOUNT_ID=your_cloudflare_account_id        # Found on R2 overview page (top right)
R2_ACCESS_KEY_ID=your_r2_access_key_id          # From R2 API Token creation
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key  # From R2 API Token creation — NEVER expose
R2_BUCKET_NAME=lesson-audio                     # R2 bucket name (default: lesson-audio)
R2_PUBLIC_URL=https://pub-xxxx.r2.dev           # Public bucket URL from R2 bucket Settings tab

# ── Alert emails (rate limit notifications) ──────────────────────────────────
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your-gmail@gmail.com
ALERT_SMTP_PASSWORD=your-gmail-app-password
ALERT_TO_EMAIL=likhapohai@gmail.com

# ── Marketing Demo Environment ───────────────────────────────────────────────
# Permanent demo accounts for automated screenshot and asset generation.
# These accounts are isolated from production users (email prefix: marketing.)
# Set strong passwords. NEVER commit actual passwords to version control.
MARKETING_STUDENT_EMAIL=marketing.student@likhapoha.in
MARKETING_STUDENT_PASSWORD=

MARKETING_PARENT_EMAIL=marketing.parent@likhapoha.in
MARKETING_PARENT_PASSWORD=

MARKETING_TEACHER_EMAIL=marketing.teacher@likhapoha.in
MARKETING_TEACHER_PASSWORD=

MARKETING_ADMIN_EMAIL=marketing.admin@likhapoha.in
MARKETING_ADMIN_PASSWORD=
# ─────────────────────────────────────────────────────────────────────────────
