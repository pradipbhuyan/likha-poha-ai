# Exclude large directories not needed for the cloud build

# node_modules — EAS Build installs these fresh from package.json
node_modules/

# Expo cache
.expo/

# NOTE: .env is intentionally NOT excluded.
# mobile/.env contains only EXPO_PUBLIC_* variables which must be read
# at build time to embed values in the JS bundle.
# All values are public-facing (Supabase anon key, public API URL).
# The service-role key and secrets are NEVER in mobile/.env.

# Build outputs
dist/
build/
android/
ios/

# Dev tools
.DS_Store
*.log
