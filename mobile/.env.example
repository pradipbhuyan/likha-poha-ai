# Likha Poha AI — Mobile App Environment Variables
# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_* variables are safe to bundle — never put secrets here.

# Backend API (your deployed FastAPI URL)
EXPO_PUBLIC_API_BASE_URL=https://your-backend-domain.com

# Supabase — use the ANON key (public, safe to expose)
EXPO_PUBLIC_SUPABASE_URL=https://dpivlbbyzlbpwnwgajso.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Razorpay — KEY ID only (not the secret)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
