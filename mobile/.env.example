# Likha Poha AI — Mobile App Environment Variables
# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_* variables are safe to bundle — never put secrets here.

# Backend API — production Render backend, fronted by the custom domain
EXPO_PUBLIC_API_BASE_URL=https://api.likhapoha.in

# For local development (phone + Mac on SAME WiFi — no local backend needed now):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:8000  ← use http:// NOT https:// for local IP

# Supabase — ANON key is public and safe to commit
EXPO_PUBLIC_SUPABASE_URL=https://dpivlbbyzlbpwnwgajso.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRwaXZsYmJ5emxicHdud2dhanNvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkyNTg0NjcsImV4cCI6MjA5NDgzNDQ2N30.E-N80sEqnsHRvd0zt2gL0slnJHTYR5GUPS5yi1o-1GM

# Razorpay — KEY ID only (not the secret)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# ── Google OAuth setup (no key required in the app) ──────────────────────────
# Google OAuth is handled entirely through Supabase — no Google Client ID needed
# in this file. Configure in Supabase Dashboard:
#   Authentication → Providers → Google → enable + add credentials
#
# Add these redirect URLs in Supabase Dashboard → Authentication → URL Configuration:
#   likhapoha://                    ← production deep link (standalone APK/IPA)
#   exp://127.0.0.1:8081            ← Expo Go on Android simulator
#   exp://localhost:8081            ← Expo Go on iOS simulator
#
# In Google Cloud Console → OAuth 2.0 Credentials → Authorized redirect URIs add:
#   https://<your-supabase-project>.supabase.co/auth/v1/callback
