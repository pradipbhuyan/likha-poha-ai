{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "types": [
      "react/canary"
    ],
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@likhapoha/shared/*": ["../shared/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "../shared/**/*.js"
  ]
}
