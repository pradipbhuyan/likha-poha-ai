# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Backend API ───────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Marketing Demo Environment ────────────────────────────────────────────────
